# Server
PORT=5000
NODE_ENV=production

# MongoDB
MONGO_URI=mongodb://localhost:27017/mtech_rl_rec

# JWT Secret (use a long random string in production)
JWT_SECRET=your_super_secret_key_minimum_32_chars_here

# CORS - comma separated allowed origins
# Local development:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80
# Production (replace with your actual EC2 IP or domain):
# ALLOWED_ORIGINS=http://your-ec2-ip,https://yourdomain.com
